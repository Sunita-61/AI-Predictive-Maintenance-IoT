# Environment configuration example
# Copy this file to .env and adjust variables as needed

# Application mode: development | staging | production
APP_ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Paths (can be relative to project root or absolute)
DATABASE_PATH=data/predictive_maintenance.db
MODEL_PATH=models/predictive_maintenance_rf.joblib
DATASET_PATH=data/raw/ai4i2020.csv

# Simulation and reproducible execution
RANDOM_STATE=42

# Alert Engine Thresholds (uncalibrated model score limits)
ALERT_WARNING_THRESHOLD=0.30
ALERT_CRITICAL_THRESHOLD=0.70
